# Copy this to .env.production (or set the same variable in your hosting
# provider's dashboard, e.g. Vercel Project Settings -> Environment Variables)
# before running `npm run build` for a deployment where the frontend and
# backend are on different origins.
#
# Leave this UNSET for local development: with no VITE_API_BASE_URL, API
# calls stay relative ("/api/...") and are handled by the Vite dev server
# proxy in vite.config.ts, which forwards them to http://127.0.0.1:8000.
#
# Also leave this UNSET if you deploy using the optional single-container mode
# (FastAPI serving frontend/dist itself, see backend/main.py) — in that setup
# the frontend and API share one origin, so relative paths already work.

VITE_API_BASE_URL=https://your-syncguard-backend.example.com
